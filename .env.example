# =========================================================
#  INKORA - development settings
#
#  Copy this file to .env and edit as needed.
#  .env is gitignored. This example is not.
#
#  Only used by `npm run dev`. The production build serves
#  the API from the same domain, so none of this applies
#  once the site is deployed.
# =========================================================


# Where the PHP backend is while developing.
#
# Option A - point at the live site (nothing to install):
#
#   VITE_API_PROXY=https://darkturquoise-mandrill-722077.hostingersite.com
#
#   Careful: this reads and WRITES the real database. Blogs
#   and accounts you create while testing appear on the live
#   site.
#
# Option B - run PHP and MySQL locally with XAMPP:
#
#   VITE_API_PROXY=http://localhost

VITE_API_PROXY=http://localhost:8000
